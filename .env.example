# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
APP_ENV=development
# 公网部署可填写根地址；Render 自动使用其分配的网址
PUBLIC_BASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=northwind
DB_USER=northwind_app
DB_PASSWORD=replace-with-your-database-password
# 可选：腾讯云启用 SSL 后设置证书文件绝对路径
DB_SSL_CA=
SESSION_COOKIE_SECURE=false

# 可选本地 Docker：将 DB_PORT 改为 3307，并额外设置随机根密码
# MYSQL_ROOT_PASSWORD=replace-with-another-random-password
